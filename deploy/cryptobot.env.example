# /etc/lo-cryptobot/cryptobot.env — settings for lo-cryptobot.service on loserver.
#
# Created once by deploy/install.sh (0600 root:root; systemd reads it before dropping to the
# cryptobot user) and never overwritten. Edit with sudo, then:
#   sudo systemctl restart lo-cryptobot
# Every other setting, with its default, is documented in .env.example at the repo root.

# ─── Binance ────────────────────────────────────────────────────────────────────────────
# PLACEHOLDERS: until both are replaced the bot uses public market data only, simulates every
# trade, and GET /balances says the keys are still placeholders. Read-only keys are enough
# for balances.
BINANCE_API_KEY=PLACEHOLDER_BINANCE_API_KEY
BINANCE_API_SECRET=PLACEHOLDER_BINANCE_API_SECRET
BINANCE_API_PASSWORD=
BASE_CURRENCY=USDT

# ─── Live trading: BOTH lines, plus real keys. Nothing over the API can change these. ──
LLAMA_SENTIMENT_SIMULATE_ONLY=True
CRYPTOBOT_ALLOW_LIVE=0

# ─── Sentiment model: the llama-server the Lo's Server agent uses ───────────────────────
# It belongs to the scraper's compose stack and is not started at boot; while it is down the
# bot runs on trend alone and /status says the model is not reachable.
LLAMA_API_STYLE=openai
LLAMA_API_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_NAME=local
LLAMA_API_KEY=
LLAMA_DISABLE_THINKING=1
# ~9.5 tokens/s on CPU, plus a cold start of up to ~105 s.
LLAMA_REQUEST_TIMEOUT=120
LLAMA_NUM_PREDICT=32

# ─── Pace: gentle on a CPU-bound model that the agent shares ────────────────────────────
TRADE_INTERVAL=60
SENTIMENT_TTL_SECONDS=900
SENTIMENT_MAX_QPS=0.05

# ─── Strategy ───────────────────────────────────────────────────────────────────────────
USE_PORTFOLIO_STRATEGY=1
SENTIMENT_COINS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA,AVAX

# ─── Control API and paper wallet ───────────────────────────────────────────────────────
CRYPTOBOT_CONTROL_BIND=127.0.0.1
CRYPTOBOT_CONTROL_PORT=8097
CRYPTOBOT_CONTROL_TOKEN=
CRYPTOBOT_AUTOSTART=0
CRYPTOBOT_PAPER_USDT=1000
CRYPTOBOT_CYCLE_SENTIMENT_BUDGET_S=150
LOG_LEVEL=INFO
