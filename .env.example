# CryptoBotFinal settings — copy to .env next to main.py and edit. Never commit the copy:
# .gitignore excludes .env and .env.*, except this example.
#
# Every setting is optional; the values shown are the defaults. For the server service, the
# installer starts from deploy/cryptobot.env.example instead (same settings, tuned for loserver).

# ─── Binance ────────────────────────────────────────────────────────────────────────────
# PLACEHOLDERS. While these stay as they are, the bot uses public market data only (prices and
# candles, no account), simulates every trade, and GET /balances answers that the keys are
# still placeholders. Replace both with a real key pair to read balances; read-only keys are
# enough for that. (Trading needs a key with spot trading enabled — and see "Live trading".)
BINANCE_API_KEY=PLACEHOLDER_BINANCE_API_KEY
BINANCE_API_SECRET=PLACEHOLDER_BINANCE_API_SECRET
# Leave empty unless your exchange account requires a passphrase.
BINANCE_API_PASSWORD=
BASE_CURRENCY=USDT

# ─── Live trading (two switches, both needed, plus real keys) ───────────────────────────
# The master switch, shared with the desktop GUI: only "False" (or 0/no/off) turns simulation
# off; a typo keeps it on.
LLAMA_SENTIMENT_SIMULATE_ONLY=True
# The headless service's own second switch: live trading needs exactly "1" here AS WELL. Not
# settable over the control API, by design — only by whoever can edit this file.
CRYPTOBOT_ALLOW_LIVE=0

# ─── Sentiment model ────────────────────────────────────────────────────────────────────
# "ollama" (default; POST {base}/generate) or "openai" (POST {base}/chat/completions, e.g.
# llama.cpp's llama-server). On loserver, share the agent's llama-server:
#   LLAMA_API_STYLE=openai
#   LLAMA_API_BASE_URL=http://127.0.0.1:8080/v1
#   LLAMA_MODEL_NAME=local
LLAMA_API_STYLE=ollama
# Default: http://localhost:11434/api for ollama, http://127.0.0.1:8080/v1 for openai.
LLAMA_API_BASE_URL=
LLAMA_MODEL_NAME=llama3.1:8b-instruct-q4_K_M
# Only if the OpenAI-style server was started with --api-key. Never logged or shown.
LLAMA_API_KEY=
# Qwen3-family models think before answering unless told not to; with the bot's 32-token
# budget that leaves no answer. 1 = send chat_template_kwargs.enable_thinking=false (openai style).
LLAMA_DISABLE_THINKING=1
LLAMA_REQUEST_TIMEOUT=45
LLAMA_NUM_PREDICT=32

# ─── Strategy ───────────────────────────────────────────────────────────────────────────
# Default strategy for POST /start without one (and for the GUI): 1 = portfolio, 0 = hybrid.
USE_PORTFOLIO_STRATEGY=1
SENTIMENT_COINS=BTC,ETH,SOL,BNB,XRP,DOGE,ADA,AVAX
SENTIMENT_BUY_THRESHOLD=0.45
SENTIMENT_SELL_THRESHOLD=-0.40
SENTIMENT_WEIGHT=0.6
TREND_WEIGHT=0.4
STOP_LOSS_PCT=0.15
POSITION_MAX_DAYS=10
MIN_TRADE_USD=5.0
OPP_BASE_NOTIONAL_USD=15.0
# Seconds between decision cycles (the server example uses 60).
TRADE_INTERVAL=10
# How long a sentiment score stays fresh, and the scheduler's request rate. loserver's model
# answers at ~9.5 tokens/s on CPU and serves the agent too, so the server example refreshes
# far more slowly (900 s, 0.05/s).
SENTIMENT_TTL_SECONDS=240
SENTIMENT_MAX_QPS=0.25
LOG_LEVEL=INFO

# ─── Headless service (headless.py / lo-cryptobot.service) ──────────────────────────────
# The control API. Loopback only: any other address is refused at start.
CRYPTOBOT_CONTROL_BIND=127.0.0.1
CRYPTOBOT_CONTROL_PORT=8097
# Optional bearer token (16+ characters) every API request must carry. Empty = none; the
# Lo's Server agent's plugin does not send one.
CRYPTOBOT_CONTROL_TOKEN=
# 1 = start the trading loop when the service starts. Off by default: start it with
# POST /start (the agent's crypto_start).
CRYPTOBOT_AUTOSTART=0
# The paper wallet simulated trades fill against starts with this much BASE_CURRENCY. It is
# kept in the state directory (paper.json); delete that file to start over.
CRYPTOBOT_PAPER_USDT=1000
# A cycle requested while the loop is stopped scores stale coins itself, for up to this long.
CRYPTOBOT_CYCLE_SENTIMENT_BUDGET_S=150
# Where state and logs go when run by hand (the systemd unit sets these itself; do not set
# them in the server's cryptobot.env, or the sandbox will make them read-only):
# CRYPTOBOT_STATE_DIR=./state
# CRYPTOBOT_LOG_DIR=./logs
